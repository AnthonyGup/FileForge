        <mxCell id="shares" parent="1" style="swimlane;fontStyle=1;fontSize=13;startSize=30;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" value="shares" vertex="1">
